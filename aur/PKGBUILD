_upstream_ref='685ef54d05ae054bce932566399a79fa8282b43d'
_chatgpt_ver='26.1106.51428'
source=(
  "codex-desktop-linux::git+https://github.com/ilysenko/codex-desktop-linux.git#commit=${_upstream_ref}"
  'arch-legacy-package.patch'
  'linux-features.json'
  'LICENSE'
  'DISCLAIMER.md'
)
sha256sums=(
  'SKIP'
  '73836d6f77e8e6e55147adcc4e47dad5b4f47a7023dce109faf561310c9d9eab'
  '23f3651641c1d2deb6f276cdee8a174ff77b28a169e0425bfa755741e2a523c0'
  '240808ad5dc4e6267fb92e6a77e34d87614b0a934415b70562657534a956d161'
  '75e2921aec7edfbe78906419394dfbaf93fba0373cc6cd92a2d9a49109f383d3'
)
source_x86_64=("chatgpt_amd64.deb::https://persistent.oaistatic.com/codex-app-prod/linux/deb/pool/main/c/chatgpt/chatgpt_${_chatgpt_ver}_amd64.deb")
sha256sums_x86_64=('8356a7821930b135b741347faccbc43e1692b4424c3eab710a9af56c0bebb135')
source_aarch64=("chatgpt_arm64.deb::https://persistent.oaistatic.com/codex-app-prod/linux/deb/pool/main/c/chatgpt/chatgpt_${_chatgpt_ver}_arm64.deb")
sha256sums_aarch64=('ce49ac9a1efc1b5326504b0169570b8d0973f4b18461fbcc0597bbfe5310a9bb')

prepare() {
  cd "$srcdir/codex-desktop-linux"
  git apply "$srcdir/arch-legacy-package.patch"
}

build() {
  export CODEX_LINUX_FEATURES_CONFIG="$srcdir/linux-features.json"
  export TMPDIR="${TMPDIR:-$srcdir/codex-build-tmp}"
  mkdir -p "$TMPDIR"
  local upstream_deb
  case "$CARCH" in
    x86_64) upstream_deb="$srcdir/chatgpt_amd64.deb" ;;
    aarch64) upstream_deb="$srcdir/chatgpt_arm64.deb" ;;
    *) return 1 ;;
  esac

  cd "$srcdir/codex-desktop-linux"
  CODEX_APP_ID=codex-desktop \
    CODEX_APP_DISPLAY_NAME='ChatGPT Community' \
    CODEX_INSTALL_DIR="$srcdir/codex-desktop-linux/codex-app" \
    UPSTREAM_DEB= \
    ./install.sh "$upstream_deb"

  MAX_BUILD_THREADS="$(nproc)" \
    CARGO_TARGET_DIR="$srcdir/cargo-target" \
    PACKAGE_NAME=codex-desktop \
    PACKAGE_VERSION="$pkgver" \
    PACKAGE_DISPLAY_NAME='ChatGPT Community' \
    PACKAGE_COMMENT='Community Linux distribution based on OpenAI ChatGPT' \
    PACKAGE_WITH_UPDATER=1 \
    UPDATER_BINARY_SOURCE="$srcdir/cargo-target/release/codex-update-manager" \
    make -e pacman
}

package() {
  local package_file
  package_file="$(find "$srcdir/codex-desktop-linux/dist" -maxdepth 1 -type f \
    -name 'codex-desktop-*.pkg.tar.*' -print | sort -V | tail -n 1)"
  [ -n "$package_file" ] || return 1

  bsdtar -xf "$package_file" -C "$pkgdir"
  rm -f "$pkgdir/.BUILDINFO" "$pkgdir/.INSTALL" "$pkgdir/.MTREE" "$pkgdir/.PKGINFO"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.packaging"
  install -Dm644 "$srcdir/DISCLAIMER.md" "$pkgdir/usr/share/licenses/$pkgname/DISCLAIMER.md"
}
