--- a/packaging/linux/codex-desktop-entry-doctor.sh
+++ b/packaging/linux/codex-desktop-entry-doctor.sh
@@ -38,6 +38,13 @@ codex_desktop_entry_is_legacy_generated() {
     grep -Eq '(^Exec=.*codex-desktop|^TryExec=.*codex-desktop|^Icon=codex-desktop$)' \
         "$codex_desktop_file" || return 1
 
+    # Older Arch packages generated a complete user-local entry. It already
+    # has the current actions, but still shadows the system package entry.
+    if grep -q '^Comment=Run Codex Desktop on Linux$' "$codex_desktop_file" &&
+       grep -Eq '^Exec=env (CODEX_CLI_PATH=[^[:space:]]+ )?BAMF_DESKTOP_FILE_HINT=[^[:space:]]*/\.local/share/applications/codex-desktop\.desktop CHROME_DESKTOP=codex-desktop\.desktop /usr/bin/codex-desktop([[:space:]]|$)' "$codex_desktop_file"; then
+        return 0
+    fi
+
     if grep -Eq 'codex-desktop-open-next|^Actions=NewWindow([;]|$)|^\[Desktop Action NewWindow\]$|^Actions=NewInstance([;]|$)|^\[Desktop Action NewInstance\]$' \
         "$codex_desktop_file"; then
         return 0
