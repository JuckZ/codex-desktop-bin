+async fn check(
+    config: &RuntimeConfig,
+    state: &mut PersistedState,
+    paths: &RuntimePaths,
+    explicit_retry: bool,
+) -> Result<()> {
     let _lock = match CheckLock::try_acquire(&paths.state_dir.join("check.lock"))? {
         Some(lock) => lock,
         None => { info!("another update check is active"); return Ok(()); }
     };
